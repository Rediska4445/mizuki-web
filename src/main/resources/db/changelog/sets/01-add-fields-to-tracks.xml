<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="1" author="rediska">
        <comment>Это уебище не работает!</comment>
        <dropColumn tableName="tracks" columnName="likes_count"/>
        <dropColumn tableName="tracks" columnName="plays_count"/>
        <dropColumn tableName="tracks" columnName="description"/>

        <modifySql dbms="postgresql">
            <replace replace="DROP COLUMN" with="DROP COLUMN IF EXISTS"/>
        </modifySql>
    </changeSet>

    <changeSet id="2" author="rediska">
        <comment>Это уебище не работает!</comment>

        <addColumn tableName="tracks">
            <column name="likes_count" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="plays_count" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>